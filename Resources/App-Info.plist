<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Kurarin</string>
	<key>CFBundleIdentifier</key>
	<string>com.byeolki.kurarin</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Kurarin</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.2</string>
	<!-- The menu bar is the whole interface. Without this the app also takes a
	     Dock icon it has no use for: there is nothing to click it for that the
	     menu bar item does not already do, and a voice changer is something you
	     leave running behind a game rather than switch to. Quit and Settings
	     both live in the menu, and the window activates the app itself when it
	     opens, which is what an agent app has to do to come to the front. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Kurarin reads your microphone so it can transform your voice before other apps hear it.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Kurarin captures system audio so you can share music and sound effects through your microphone.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
